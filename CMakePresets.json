{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-gcc",
      "displayName": "Development (GCC, Debug, ASan/UBSan)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KURA_ENABLE_SANITIZERS": "ON",
        "KURA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev-clang",
      "displayName": "Development (Clang, Debug, ASan/UBSan)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KURA_ENABLE_SANITIZERS": "ON",
        "KURA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "analyze",
      "displayName": "Static analysis (clang-tidy + cppcheck)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/analyze",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KURA_ENABLE_CLANG_TIDY": "ON",
        "KURA_ENABLE_CPPCHECK": "ON",
        "KURA_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-gcc",
      "configurePreset": "dev-gcc"
    },
    {
      "name": "dev-clang",
      "configurePreset": "dev-clang"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "analyze",
      "configurePreset": "analyze"
    }
  ],
  "testPresets": [
    {
      "name": "dev-gcc",
      "configurePreset": "dev-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-clang",
      "configurePreset": "dev-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "analyze",
      "configurePreset": "analyze",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
